# Copy to .env and fill in. .env is git-ignored.

# Scoring + fact-checking (TypeSafe System One / Jev). Create a key at https://console.typesafe.ai
TYPESAFE_API_KEY=

# Resume + cover letter writer (any OpenRouter model; see config.yaml -> models.writer). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: Telegram digest + questions. Run `python -m jobhunt telegram-setup` after setting the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: full path to Chrome/Chromium if it is not found automatically (used to print PDFs)
CHROME_PATH=
